root = true

[*]
indent_style = tab
indent_size = 4
tab_width = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{c,cc,cxx,cpp,h,hh,hxx,hpp}]
indent_style = tab
max_line_length = 120

[CMakeLists.txt]
indent_style = space

[*.cmake]
indent_style = space

[*.md]
indent_style = space
indent_size = 2

[*.rst]
indent_style = space
indent_size = 4
